    "\"%@\" se va a borrar de B2. Esto no se puede deshacer.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" will be deleted from B2. This can't be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" se va a borrar de B2. Esto no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" va être supprimé de B2. Cette action est irréversible."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" vai ser eliminado da B2. Isto não pode ser desfeito."
          }
        }
      }
    },
    "\"%@\" y todo su contenido se va a borrar de B2. Esto no se puede deshacer.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" and everything inside it will be deleted from B2. This can't be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" y todo su contenido se va a borrar de B2. Esto no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" et tout son contenu vont être supprimés de B2. Cette action est irréversible."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" e todo o seu conteúdo vão ser eliminados da B2. Isto não pode ser desfeito."
          }
        }
      }
    },
