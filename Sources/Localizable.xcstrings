    "Súbelo con conexión rápida y muchos archivos chicos; bájalo en wifi débil o compartido. 4 es un buen default.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Súbelo con conexión rápida y muchos archivos chicos; bájalo en wifi débil o compartido. 4 es un buen default."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Raise it with a fast connection and lots of small files; lower it on weak or shared Wi-Fi. 4 is a good default."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aumente com conexão rápida e muitos arquivos pequenos; diminua em wi-fi fraco ou compartilhado. 4 é um bom padrão."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Augmentez-le avec une connexion rapide et beaucoup de petits fichiers ; baissez-le sur un Wi-Fi faible ou partagé. 4 est une bonne valeur par défaut."
          }
        }
      }
    },
