    "B2 no guarda carpetas vacías. No van a aparecer del otro lado:\n%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "B2 doesn't store empty folders. They won't show up on the other side:\n%@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "B2 no guarda carpetas vacías. No van a aparecer del otro lado:\n%@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "B2 ne conserve pas les dossiers vides. Ils n'apparaîtront pas de l'autre côté :\n%@"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A B2 não guarda pastas vazias. Elas não vão aparecer do outro lado:\n%@"
          }
        }
      }
    },
    "BackBlaze2Sync necesita rclone instalado para funcionar. Son dos comandos, una sola vez, en la app Terminal de tu Mac.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "BackBlaze2Sync needs rclone installed to work. It's two commands, a one-time thing, in your Mac's Terminal app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "BackBlaze2Sync necesita rclone instalado para funcionar. Son dos comandos, una sola vez, en la app Terminal de tu Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "BackBlaze2Sync a besoin de rclone pour fonctionner. Ce sont deux commandes, à faire une seule fois, dans l'app Terminal de votre Mac."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O BackBlaze2Sync precisa do rclone instalado para funcionar. São dois comandos, só uma vez, no app Terminal do seu Mac."
          }
        }
      }
    },
    "Backblaze B2 no permite más de 7 días para este tipo de link.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backblaze B2 doesn't allow more than 7 days for this type of link."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Backblaze B2 no permite más de 7 días para este tipo de link."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Backblaze B2 n'autorise pas plus de 7 jours pour ce type de lien."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A Backblaze B2 não permite mais de 7 dias para este tipo de link."
          }
        }
      }
    },
    "Borrar": {
      "localizations": {
        "en": {
