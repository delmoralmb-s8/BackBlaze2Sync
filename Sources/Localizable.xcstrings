    "Escaneando el bucket completo… puede tardar en buckets grandes.": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Scanning the whole bucket… this can take a while for large buckets." } },
        "es": { "stringUnit": { "state": "translated", "value": "Escaneando el bucket completo… puede tardar en buckets grandes." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Analyse complète du bucket… cela peut prendre du temps pour les gros buckets." } },
        "pt": { "stringUnit": { "state": "translated", "value": "Escaneando o bucket inteiro… pode demorar em buckets grandes." } }
      }
    },
    "Tu actividad en BackBlaze2Sync": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Your activity in BackBlaze2Sync" } },
        "es": { "stringUnit": { "state": "translated", "value": "Tu actividad en BackBlaze2Sync" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Votre activité dans BackBlaze2Sync" } },
        "pt": { "stringUnit": { "state": "translated", "value": "Sua atividade no BackBlaze2Sync" } }
      }
    },
    "Solo cuenta lo hecho con esta app (hasta las últimas 2000 operaciones), no todo lo que hay en el bucket.": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Only counts what you did with this app (up to the last 2000 operations), not everything in the bucket." } },
        "es": { "stringUnit": { "state": "translated", "value": "Solo cuenta lo hecho con esta app (hasta las últimas 2000 operaciones), no todo lo que hay en el bucket." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Ne compte que ce qui a été fait avec cette app (jusqu'aux 2000 dernières opérations), pas tout ce qu'il y a dans le bucket." } },
        "pt": { "stringUnit": { "state": "translated", "value": "Conta apenas o que foi feito com este app (até as últimas 2000 operações), não tudo que há no bucket." } }
      }
    },
    "Promedio subido por día": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Average uploaded per day" } },
        "es": { "stringUnit": { "state": "translated", "value": "Promedio subido por día" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Moyenne envoyée par jour" } },
        "pt": { "stringUnit": { "state": "translated", "value": "Média enviada por dia" } }
      }
    },
    "Hora en la que más subes": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Hour you upload most" } },
        "es": { "stringUnit": { "state": "translated", "value": "Hora en la que más subes" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Heure où vous envoyez le plus" } },
        "pt": { "stringUnit": { "state": "translated", "value": "Hora em que mais você envia" } }
      }
    },
    "Total descargado": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Total downloaded" } },
        "es": { "stringUnit": { "state": "translated", "value": "Total descargado" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Total téléchargé" } },
        "pt": { "stringUnit": { "state": "translated", "value": "Total baixado" } }
      }
    },
    "\"%@\" se va a borrar de B2. Esto no se puede deshacer.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" will be deleted from B2. This can't be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" se va a borrar de B2. Esto no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" va être supprimé de B2. Cette action est irréversible."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" vai ser eliminado da B2. Isto não pode ser desfeito."
          }
        }
      }
    },
    "\"%@\" y todo su contenido se va a borrar de B2. Esto no se puede deshacer.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" and everything inside it will be deleted from B2. This can't be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" y todo su contenido se va a borrar de B2. Esto no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" et tout son contenu vont être supprimés de B2. Cette action est irréversible."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" e todo o seu conteúdo vão ser eliminados da B2. Isto não pode ser desfeito."
          }
        }
      }
    },
