{
  "sourceLanguage": "es",
  "strings": {
    "Estadísticas": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Stats" } },
        "es": { "stringUnit": { "state": "translated", "value": "Estadísticas" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Statistiques" } },
        "pt": { "stringUnit": { "state": "translated", "value": "Estatísticas" } }
      }
    },
    "Tu bucket ahora mismo": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Your bucket right now" } },
        "es": { "stringUnit": { "state": "translated", "value": "Tu bucket ahora mismo" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Votre bucket en ce moment" } },
        "pt": { "stringUnit": { "state": "translated", "value": "Seu bucket agora" } }
      }
    },
    "Conéctate a un bucket para ver sus estadísticas.": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Connect to a bucket to see its stats." } },
        "es": { "stringUnit": { "state": "translated", "value": "Conéctate a un bucket para ver sus estadísticas." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Connectez-vous à un bucket pour voir ses statistiques." } },
        "pt": { "stringUnit": { "state": "translated", "value": "Conecte-se a um bucket para ver suas estatísticas." } }
      }
    },
    "No se pudo escanear el bucket. Intenta \"Actualizar\".": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Couldn't scan the bucket. Try \"Update\"." } },
        "es": { "stringUnit": { "state": "translated", "value": "No se pudo escanear el bucket. Intenta \"Actualizar\"." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Impossible d'analyser le bucket. Essayez \"Actualiser\"." } },
        "pt": { "stringUnit": { "state": "translated", "value": "Não foi possível escanear o bucket. Tente \"Atualizar\"." } }
      }
    },
    "Archivo más antiguo": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Oldest file" } },
        "es": { "stringUnit": { "state": "translated", "value": "Archivo más antiguo" } },
