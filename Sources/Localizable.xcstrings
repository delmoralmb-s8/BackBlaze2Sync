    "Clic en una carpeta la marca como destino; el triángulo (o doble clic) explora más adentro.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clicking a folder marks it as the destination; the triangle (or double-click) explores deeper."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clic en una carpeta la marca como destino; el triángulo (o doble clic) explora más adentro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquer sur un dossier le marque comme destination ; le triangle (ou le double-clic) permet d'explorer plus profondément."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Clicar numa pasta marca-a como destino; o triângulo (ou duplo clique) explora mais a fundo."
          }
        }
      }
    },
