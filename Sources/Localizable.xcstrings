    "Corre como un proceso en segundo plano que sigue subiendo aunque cierres BackBlaze2Sync. No verás la ventana de la app mientras corre así.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runs as a background process that keeps uploading even after you quit BackBlaze2Sync. You won't see the app's window while it runs this way."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Corre como un proceso en segundo plano que sigue subiendo aunque cierres BackBlaze2Sync. No verás la ventana de la app mientras corre así."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S'exécute comme un processus en arrière-plan qui continue d'envoyer même après avoir quitté BackBlaze2Sync. Tu ne verras pas la fenêtre de l'app tant qu'elle fonctionne ainsi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Roda como um processo em segundo plano que continua enviando mesmo depois de fechar o BackBlaze2Sync. Você não vai ver a janela do app enquanto ele rodar assim."
          }
        }
      }
    },
