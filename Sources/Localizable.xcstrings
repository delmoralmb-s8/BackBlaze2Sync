    "Crea una conexión rclone con tus propias credenciales de Backblaze B2. Se guarda para poder elegirla después junto con \"%@\".": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creates an rclone connection with your own Backblaze B2 credentials. It's saved so you can pick it later alongside \"%@\"."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una conexión rclone con tus propias credenciales de Backblaze B2. Se guarda para poder elegirla después junto con \"%@\"."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Crée une connexion rclone avec vos propres identifiants Backblaze B2. Elle est enregistrée pour pouvoir la choisir plus tard à côté de \"%@\"."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cria uma ligação rclone com as suas próprias credenciais da Backblaze B2. É guardada para poder escolhê-la mais tarde junto com \"%@\"."
          }
        }
      }
    },
