    "La carpeta ya no existe (¿la renombraste o la borraste?). Elige otra o desactiva la sincronización.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The folder no longer exists (did you rename or delete it?). Pick another one or turn off the sync."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carpeta ya no existe (¿la renombraste o la borraste?). Elige otra o desactiva la sincronización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier n'existe plus (l'as-tu renommé ou supprimé ?). Choisis-en un autre ou désactive la synchronisation."
          }
        },
        "pt": {
          "stringUnit": {
