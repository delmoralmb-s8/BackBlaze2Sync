    "Solo cuenta lo hecho con esta app (hasta las últimas 2000 operaciones), no todo lo que hay en el bucket.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only counts what you did with this app (up to the last 2000 operations), not everything in the bucket."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo cuenta lo hecho con esta app (hasta las últimas 2000 operaciones), no todo lo que hay en el bucket."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne compte que ce qui a été fait avec cette app (jusqu'aux 2000 dernières opérations), pas tout ce qu'il y a dans le bucket."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Conta apenas o que foi feito com este app (até as últimas 2000 operações), não tudo que há no bucket."
          }
        }
      }
    },
