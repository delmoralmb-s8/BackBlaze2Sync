    "B2 no guarda carpetas vacías — estas no van a aparecer del otro lado:\n%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "B2 doesn't store empty folders — these won't show up on the other side:\n%@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "B2 no guarda carpetas vacías — estas no van a aparecer del otro lado:\n%@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "B2 ne conserve pas les dossiers vides — ceux-ci n'apparaîtront pas de l'autre côté :\n%@"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A B2 não guarda pastas vazias — estas não vão aparecer do outro lado:\n%@"
          }
        }
      }
    },
    "Backblaze B2 no permite más de 7 días para este tipo de link.": {
      "localizations": {
