    "No se encontró ese bucket en tu cuenta de Backblaze. Revisa que el nombre esté escrito exactamente igual (B2 distingue mayúsculas y minúsculas).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That bucket wasn't found in your Backblaze account. Check that the name is spelled exactly the same (B2 is case-sensitive)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró ese bucket en tu cuenta de Backblaze. Revisa que el nombre esté escrito exactamente igual (B2 distingue mayúsculas y minúsculas)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce bucket n'a pas été trouvé dans votre compte Backblaze. Vérifiez que le nom est écrit exactement pareil (B2 est sensible à la casse)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
